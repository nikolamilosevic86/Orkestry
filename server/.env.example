# ============================
# Database Configuration
# ============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orkestry
POSTGRES_USER=orkestry_user
POSTGRES_PASSWORD=changeme_secure_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================
# Qdrant Configuration
# ============================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=mcp_servers
QDRANT_USE_HTTPS=false
QDRANT_API_KEY=

# ============================
# Embedding Model Configuration
# ============================
# Model name from HuggingFace for encoding MCP server descriptions
EMBEDDING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Dimension of the embedding model (384 for ms-marco-MiniLM-L-6-v2)
EMBEDDING_DIMENSION=384
# Device to use for embeddings: 'cpu', 'cuda', or 'mps'
EMBEDDING_DEVICE=cpu

# ============================
# Authentication & Security
# ============================
# Secret key for JWT tokens - CHANGE THIS IN PRODUCTION!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin user credentials (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password
ADMIN_EMAIL=admin@orkestry.local

# ============================
# Server Configuration
# ============================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
SERVER_WORKERS=1
LOG_LEVEL=info

# ============================
# Docker Configuration
# ============================
# Set to 'true' to automatically install/start Postgres and Qdrant via Docker
AUTO_SETUP_DOCKER=true
DOCKER_NETWORK=orkestry_network

# ============================
# CORS Configuration
# ============================
CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_PER_MINUTE=60

# ============================
# MCP Proxy Configuration
# ============================
# Timeout for proxied MCP requests (seconds)
MCP_PROXY_TIMEOUT=30
# Maximum response size (MB)
MCP_PROXY_MAX_RESPONSE_SIZE=10
